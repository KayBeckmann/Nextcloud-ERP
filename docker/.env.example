# Kopieren nach .env und bei Bedarf anpassen. .env wird nicht committet.

NEXTCLOUD_VERSION=34
NEXTCLOUD_HTTP_PORT=8080
NEXTCLOUD_TRUSTED_DOMAINS=localhost 127.0.0.1

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=replace-with-a-local-dev-password

POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=replace-with-a-local-dev-password
